# ---------------------------------------------------------------
# OutreachOS — local / self-hosted environment
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------

# --- Database & auth (same database as the live app) ---
# These two are PUBLIC keys (safe in the browser). Values are prefilled.
VITE_SUPABASE_URL="https://vnafinjeemyukcdntscf.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_unbuamFsMxUS0VGmH_XJDg_iKbNPsW2"
VITE_SUPABASE_PROJECT_ID="vnafinjeemyukcdntscf"
SUPABASE_URL="https://vnafinjeemyukcdntscf.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_unbuamFsMxUS0VGmH_XJDg_iKbNPsW2"

# Admin key — only needed for storing SMTP / Gmail mailbox passwords.
# Not available while the database is hosted on Lovable Cloud; leave empty
# and send through Resend instead (recommended).
SUPABASE_SERVICE_ROLE_KEY=""

# --- Resend (sending) ---
# Create a key at https://resend.com/api-keys (starts with "re_").
# One Resend account + one verified domain can send from ANY address on
# that domain (info@, bookings@, schools@ ...). Each campaign picks its own
# "Send from" address in the app.
RESEND_API_KEY=""
RESEND_MODE="direct"

# Public URL of your running app — used for the open-tracking pixel.
# Locally opens can't be tracked (recipients can't reach localhost).
APP_URL="http://localhost:8080"

# --- Optional: SMTP / Gmail mailbox sending ---
# 32-byte base64 key used to encrypt stored mailbox passwords.
# Generate with:  openssl rand -base64 32
APP_USER_CONNECTION_KEY_SECRET=""
